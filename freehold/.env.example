# Placeholders only. Real values are set in Vercel by the owner and never committed.
BREVO_API_KEY=
BREVO_LIST_ID=1
NEXT_PUBLIC_SITE_URL=https://freeholdprivate.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@freeholdprivate.com
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Inquiry delivery. The message is emailed to INQUIRY_TO through Brevo's
# transactional API from BREVO_SENDER (a sender verified in Brevo); the
# address also joins list BREVO_LIST_ID. Create contact attributes FH_KIND
# and FH_DATE (text) in Brevo once, or the contact call returns 400 and only
# the email is delivered.
INQUIRY_TO=
BREVO_SENDER=

# A Cal.com or Calendly link. When set, "Request a call" opens the calendar.
NEXT_PUBLIC_BOOKING_URL=
# The review's fixed fee as it should appear, e.g. $2,500. Hidden until set.
NEXT_PUBLIC_REVIEW_FEE=
