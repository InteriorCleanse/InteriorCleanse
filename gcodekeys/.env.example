# GCode Keys — environment template. Copy to .env.local for dev.
# NEVER commit real keys. On Vercel, set these in Project Settings.

# Stripe (payments). Leave blank to run the store in preview mode.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Public site URL, e.g. https://gcodekeys.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Operator console password (admin). Placeholder only.
OPERATOR_PASSWORD=
