# GCode Keys — environment template. Copy to .env.local for dev.
# NEVER commit real keys. On Vercel, set these in Project Settings.

# Stripe (payments). Leave blank to run the store in preview mode.
# - STRIPE_SECRET_KEY        enables the operator payment-link API + webhook.
# - STRIPE_WEBHOOK_SECRET    signing secret from the Stripe webhook endpoint
#                            pointed at https://gcodekeys.com/api/webhook/
# - NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY  reserved for future client-side use;
#                            the current hosted-checkout flow does not need it.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Public site URL, e.g. https://gcodekeys.com — used for Stripe return URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Operator console. OPERATOR_PASSWORD gates /operator and the payment-link API.
# OPERATOR_SESSION_SECRET signs the session cookie; if unset it falls back to
# OPERATOR_PASSWORD, so one strong value is enough to start. Placeholders only.
OPERATOR_PASSWORD=
OPERATOR_SESSION_SECRET=

# Order store (Vercel KV / Upstash Redis). Without these, orders are kept in
# memory only (fine for preview, NOT durable in production). Add a Vercel KV
# store to the project and these are populated automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Transactional email (Resend). Without RESEND_API_KEY, emails are logged and
# skipped. EMAIL_FROM must be a verified sender. OPERATOR_EMAIL is where new-
# order and payment alerts are sent (your dispatch inbox).
RESEND_API_KEY=
EMAIL_FROM=GCode Keys <hello@gcodekeys.com>
OPERATOR_EMAIL=
