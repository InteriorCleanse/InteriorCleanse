# Copy to .env.local for local development.
# In production these live in Vercel → Settings → Environment Variables.
# See VERCEL_ENV_SETUP.md for where to find each value.

# ── Stripe ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Printful ──────────────────────────────────────────────────────────
PRINTFUL_API_KEY=xxx
PRINTFUL_STORE_ID=xxx

# ── Printify ──────────────────────────────────────────────────────────
PRINTIFY_API_KEY=xxx
PRINTIFY_SHOP_ID=xxx

# ── Brevo (email + CRM) ───────────────────────────────────────────────
BREVO_API_KEY=xxx
BREVO_LIST_SUBSCRIBERS=1
BREVO_LIST_CUSTOMERS=2

# ── Claude (AI email generation) ──────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxx

# ── Admin dashboard ───────────────────────────────────────────────────
# Password for /admin. ADMIN_SESSION_SECRET signs the auth cookie —
# generate with: openssl rand -hex 32
ADMIN_PASSWORD=xxx
ADMIN_SESSION_SECRET=xxx

# ── Product pipeline (/admin/products) ────────────────────────────────
# On Vercel the filesystem is read-only, so catalog edits and image uploads
# are committed to GitHub and go live on the next deploy. Create a
# fine-grained personal access token scoped to this ONE repository with
# "Contents: Read and write". Locally none of these are needed — edits write
# straight to content/catalog.json and public/products/.
GITHUB_TOKEN=github_pat_xxx
GITHUB_REPO=InteriorCleanse/InteriorCleanse
GITHUB_BRANCH=main
# Force the GitHub backend off Vercel (e.g. a preview server): CATALOG_BACKEND=github

# Optional. Without it, "Cut out background" falls back to a white-threshold
# cutout that only works on product shots against a clean white sweep.
REMOVEBG_API_KEY=

# ── Site ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://interiorcleanse.com
NEXT_PUBLIC_GUMROAD_STORE=interiorcleanse

# ── Optional ──────────────────────────────────────────────────────────
NEXT_PUBLIC_EMAIL_FORM_ENDPOINT=
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
