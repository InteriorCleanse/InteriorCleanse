# Copy to .env.local for local development.
# In production these live in your host's environment settings.
# Every value here is a safe placeholder — never commit a real secret.

# ── Supabase ──────────────────────────────────────────────────────────
# supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Bypasses Row Level Security. Server-side only — it must never be sent to a
# browser, committed, or given a NEXT_PUBLIC_ prefix. Used by the owner
# bootstrap script and (from Checkpoint 6) Stripe webhook reconciliation.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Platform ownership ────────────────────────────────────────────────
# Comma-separated emails permitted to claim platform_owner exactly once.
# There is no public owner registration. After signing up normally, run:
#   node scripts/bootstrap-owner.mjs you@example.com
PLATFORM_OWNER_EMAILS=

# ── Branding (configurable without code changes) ──────────────────────
NEXT_PUBLIC_APP_NAME=AURELIS OS
NEXT_PUBLIC_ASSISTANT_NAME=Aurelis
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Assistant ─────────────────────────────────────────────────────────
# Optional. Without it every other surface still works — dashboards, imports
# and briefings are computed locally — and the assistant dock says so plainly
# instead of failing at request time.
ANTHROPIC_API_KEY=
# Defaults shown; override only if you know why.
# ASSISTANT_MODEL=claude-opus-5
# ASSISTANT_MAX_TOKENS=8000

# ── Credential vault (Checkpoint 5) ───────────────────────────────────
# Wraps the per-secret data keys that seal tenant integration credentials.
# Without it, integrations needing an API key cannot be connected at all —
# the app refuses rather than storing a secret it cannot defend.
#
#   npm run keygen        # prints a fresh 256-bit key
#
# A static key here is NOT production-grade for a multi-tenant service: it
# sits in process memory with no hardware boundary and no per-unwrap audit
# trail. For production, wire lib/vault kmsProvider() to a real KMS.
VAULT_MASTER_KEY=
# Identifier recorded on everything sealed with the key above. Change it when
# you rotate, and move the old key into VAULT_PREVIOUS_KEYS.
VAULT_MASTER_KEY_ID=k1
# Retired keys, "id:hex" comma separated. They must stay here until every
# secret has been rewrapped — removing one early is data loss, not cleanup.
VAULT_PREVIOUS_KEYS=

# ── Later checkpoints (not read yet; listed so hosts can be prepared) ──
# Checkpoint 6 — subscription billing for the product itself
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
