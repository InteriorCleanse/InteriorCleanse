# ──────────────────────────────────────────────────────────────────────────
# AVANT environment. Copy to .env.local for development. Every value here is
# a placeholder; real secrets live only in your host's secret store.
# Without any of them the app runs in DEMO mode: no charges, no real
# licence checks, and it says so on every screen that matters.
# ──────────────────────────────────────────────────────────────────────────

# Postgres: accounts, listings, photos, bookings, messages. Any provider
# (Neon, Supabase, RDS, your own). Use a pooled URL on serverless.
# Unset locally, AVANT runs an embedded Postgres (PGlite) in .data/.
# Unset on Vercel, it runs in memory and forgets everything on each cold start,
# so set this before anyone signs up.
DATABASE_URL=
# memory | embedded. Only to force a mode in tests or previews.
AVANT_DB=

# Sample listings (labelled "Sample", no photos). Set 0 in production.
NEXT_PUBLIC_AVANT_SAMPLE_FLEET=1

# Public URL, used for redirects back from Stripe and the verification page.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 32+ random bytes, base64. Signs the anonymous session cookie.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AVANT_SESSION_SECRET=

# 32 random bytes, base64. Encrypts driver records BEFORE they leave the app,
# so the vault only ever stores ciphertext, and seals messages, delivery
# addresses, pickup notes and VINs in the database. BACK IT UP: losing it
# loses all of those for good. Rotate with AVANT_ENCRYPTION_KEY_PREVIOUS.
AVANT_ENCRYPTION_KEY=
AVANT_ENCRYPTION_KEY_PREVIOUS=

# The privacy vault (services/vault). Runs on Cloudflare Workers or on your own
# machine with open-compute (`ocd wrangler deploy`). Leave empty to keep the
# sealed (encrypted) record in the database's driver_records table instead.
AVANT_VAULT_URL=
AVANT_VAULT_SIGNING_KEY=

# Stripe (payments, host payouts via Connect, and Stripe Identity licence
# verification). Test keys first.
STRIPE_SECRET_KEY=
STRIPE_IDENTITY_WEBHOOK_SECRET=
# Signing secret of the payments webhook: https://<domain>/api/webhook/stripe
STRIPE_WEBHOOK_SECRET=

# Runs /api/cron (expire unanswered requests, retry refunds, pay hosts, send
# emails). Vercel Cron sends it automatically once it is set.
CRON_SECRET=

# Email (verification, password reset, booking and message notifications)
# through Resend. Without these, notifications stay in the app's inbox only and
# new accounts are trusted without confirming their email: production needs them.
RESEND_API_KEY=
AVANT_EMAIL_FROM=AVANT <hello@example.com>

# AI concierge. Without a key the concierge answers from built-in rules.
ANTHROPIC_API_KEY=
AVANT_AI_MODEL=claude-opus-5

# Set to 1 only when real listings exist and legal review is done.
AVANT_INDEXABLE=0

# Not on Vercel: how many proxies sit in front of the app. Rate limits read the
# client address this many entries from the right of X-Forwarded-For. 0 (the
# default) ignores the header, so all callers share one bucket.
AVANT_TRUSTED_PROXY_HOPS=0
# Backstop on concierge model calls per server instance per UTC day.
AVANT_AI_DAILY_CAP=2000

# Production: 1 makes every missing secret a hard error (session and
# encryption keys, the site URL, proxy hops off Vercel) instead of a
# silent demo fallback.
AVANT_REQUIRE_SECRETS=0

# Where security researchers report problems; published at
# /.well-known/security.txt. A mailto: or https: URL.
AVANT_SECURITY_CONTACT=mailto:security@example.com

# Breached-password check at sign-up and reset (Have I Been Pwned, k-anonymity:
# only 5 characters of a SHA-1 hash leave the server). 0 turns it off.
AVANT_PWNED_CHECK=1
