# Gavel — copy to .env and fill in what you have. Every line is optional.
# No real key ever goes into the repository; this file holds placeholders only.

# Owner PIN for the admin pages. Six digits. Left blank, a random one is printed at start.
GAVEL_PIN=

# Member access codes, comma-separated. Anyone with a code can sign in as a member.
# Issue one per subscriber, or let the Stripe webhook below manage members for you.
GAVEL_MEMBER_CODES=

# Stripe subscription webhook. Paste the "whsec_" signing secret from the Stripe dashboard
# (Developers → Webhooks) into Vercel or your host, never here. Events handled:
# checkout.session.completed, customer.subscription.updated, customer.subscription.deleted.
GAVEL_STRIPE_WEBHOOK_SECRET=

# eBay Motors — the one big auction site with an official, free developer API.
# Create an app at developer.ebay.com, take the Production keyset.
GAVEL_EBAY_CLIENT_ID=
GAVEL_EBAY_CLIENT_SECRET=

# GSA Auctions — federal surplus vehicles, official and free. Get a key at api.data.gov/signup.
GAVEL_GSA_API_KEY=
# Or set GAVEL_GSA=1 to try GSA with the shared DEMO_KEY (low rate limit).
GAVEL_GSA=

# MarketCheck — paid data API: auction lots for the feed, dealer prices as comparables.
GAVEL_MARKETCHECK_API_KEY=
# Only if your MarketCheck plan uses a different auction search path.
GAVEL_MARKETCHECK_AUCTION_PATH=

# Optional AI explainer (Anthropic). Without it, the rule-based explanations still work.
ANTHROPIC_API_KEY=

# Live bidding stays OFF until you flip this to 1 AND a connected source supports it.
GAVEL_LIVE_BIDDING=0

# Sessions: set 32+ random characters so members stay signed in across restarts.
GAVEL_SESSION_SECRET=
# Listen address. 127.0.0.1 = this computer only. 0.0.0.0 = every device on the network (put HTTPS in front first).
GAVEL_HOST=
# Set to 1 when the app sits behind an HTTPS proxy that does not send X-Forwarded-Proto.
GAVEL_SECURE_COOKIES=
# Where Gavel keeps its files (watchlist, paper bids, members, settings). Default: ./data
GAVEL_DATA_DIR=
# Port for the app. Default 8790.
GAVEL_PORT=
