{
  "name": "mr-cash",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "description": "Mr. Cash — a paper-trading bot built on the ICT session model that explains every decision and learns from its own mistakes. No real money, ever.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/server.ts",
    "app": "node src/server.ts",
    "talk": "node src/talk.ts",
    "brief": "node src/index.ts brief",
    "news": "node src/index.ts news",
    "state": "node src/index.ts state",
    "flow": "node src/index.ts flow",
    "watch": "node src/watch.ts",
    "doctor": "node src/doctor.ts",
    "picture": "node src/picture.ts",
    "mcp": "node src/mcp.ts",
    "mcp:config": "node src/mcp.ts --config",
    "paper": "node src/index.ts paper",
    "scan": "node src/index.ts scan",
    "scan:memory": "node src/index.ts scan:memory",
    "replay:raw": "node src/index.ts replay:raw",
    "replay:memory": "node src/index.ts replay:memory",
    "compare": "node src/index.ts compare",
    "backtest": "node src/index.ts backtest",
    "strategies": "node src/index.ts strategies",
    "memory:show": "node src/index.ts memory:show",
    "memory:reset": "node src/index.ts memory:reset",
    "plan:clear": "node src/index.ts plan:clear",
    "selftest": "node src/selftest.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test test/*.test.ts test/features/*.test.ts test/strategies/*.test.ts test/backtest/*.test.ts",
    "check": "tsc --noEmit -p . && node src/selftest.ts && node --test test/*.test.ts test/features/*.test.ts test/strategies/*.test.ts test/backtest/*.test.ts",
    "stop": "node src/index.ts stop",
    "resume": "node src/index.ts resume",
    "status": "node src/index.ts status",
    "migrate": "node src/index.ts migrate",
    "tradingview": "node src/tradingview.ts",
    "help": "node src/index.ts help"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.115.0"
  },
  "devDependencies": {
    "@types/node": "22.19.7",
    "typescript": "5.9.3"
  }
}
