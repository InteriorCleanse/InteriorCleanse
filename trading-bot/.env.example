# =====================================================================
#  You do NOT need this file to run the bot.
# =====================================================================
#
#  Everything works with zero configuration. Prices and news come from
#  free public feeds that need no account and no key.
#
#  Copy this file to one called  .env  only if you want the optional AI
#  assistant (npm run talk, and the Ask tab in the dashboard).
#
#  Rules that do not bend:
#    - Never put a key in config.ts, in any src file, or in a chat window.
#    - .env is listed in .gitignore, so it is never uploaded anywhere.
#    - If a key ever appears in a screenshot, delete it and make a new one.

# --- Optional: the AI assistant --------------------------------------
# Get a key at https://console.anthropic.com  (pay-as-you-go; a typical
# question costs well under a cent). The bot prints the cost of every
# answer so you always know what you've spent.
# ANTHROPIC_API_KEY=

# --- Not used. Here so you know where exchange keys WOULD go. ---------
# The bot has no exchange adapter and asks for no exchange keys.
# If one is ever added it must be PAPER/TESTNET only.
# PAPER_API_KEY=
# PAPER_API_SECRET=

# Must stay false. No code reads this as true.
LIVE_TRADING=false
